# ---- Required ---------------------------------------------------------------
# Comma-separated key pool (at least 2). Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# SQLite location. In Docker this lives on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test hook on POST /chat.
ENABLE_FAILURE_SIMULATION=true

# ---- LLM --------------------------------------------------------------------
# LiteLLM model name used by every key...
LLM_MODEL=gemini/gemini-3.5-flash-lite
# ...or one model per key, aligned with LLM_API_KEYS (blank = use LLM_MODEL for all).
# Example mixing providers: LLM_MODELS=gemini/gemini-3.5-flash-lite,groq/llama-3.1-8b-instant
LLM_MODELS=
# Optional custom OpenAI-compatible base URL (blank = provider default).
LLM_API_BASE=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
# Per-key timeout before failing over to the next key.
LLM_TIMEOUT_SECONDS=30
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Max stored messages sent back to the model as context.
HISTORY_LIMIT=40

# ---- Cache (LiteLLM built-in) -------------------------------------------------
CACHE_ENABLED=true
# disk (survives restarts, stored on the /data volume) or local (in-memory)
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
CACHE_TTL_SECONDS=86400

# ---- Frontend -----------------------------------------------------------------
# Backend URL as seen by the browser (docker compose passes it to the frontend container).
PUBLIC_API_BASE_URL=http://localhost:8000
